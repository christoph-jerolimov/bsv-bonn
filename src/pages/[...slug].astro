---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';

import EventList from '@/components/EventList.astro';
import SectionNav from '@/components/SectionNav.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { idToPath } from '@/lib/paths';

export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');
  return pages
    .filter((page) => page.id !== 'index')
    .map((page) => ({
      params: { slug: idToPath(page.id).slice(1) },
      props: { page },
    }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
const currentPath = idToPath(page.id);
const { title, description, updated, hideSidebar, sectionNav, events } = page.data;
---

<PageLayout
  title={title}
  description={description}
  currentPath={currentPath}
  updated={updated}
  hideSidebar={hideSidebar}
>
  <div class="content">
    <Content />
  </div>
  {events && (
    <EventList
      mode={events}
      headingLevel="h3"
      emptyMessage={
        events === 'upcoming'
          ? 'Zurzeit sind keine weiteren Veranstaltungen eingetragen. Neue Termine werden hier veröffentlicht.'
          : 'Es sind noch keine vergangenen Veranstaltungen eingetragen.'
      }
    />
  )}
  {sectionNav && <SectionNav sectionPath={currentPath} />}
</PageLayout>
