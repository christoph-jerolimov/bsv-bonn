---
import { navigation } from '@/data/navigation';
import { href, normalizePath } from '@/lib/paths';

interface Props {
  sectionPath: string;
}

const { sectionPath } = Astro.props;
const section = navigation.find((item) => normalizePath(item.path) === normalizePath(sectionPath));
const children = section?.children ?? [];
---

{children.length > 0 && (
  <nav aria-label={`Seiten im Bereich ${section?.title}`}>
    <h2>Weitere Seiten in diesem Bereich</h2>
    <ul class="section-nav">
      {children.map((child) => (
        <li>
          <a href={href(child.path)}>{child.title}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
